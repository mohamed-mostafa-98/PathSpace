<Window x:Class="PathSpace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PathSpace" Height="680" Width="1040" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="PathSpace" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Understand local storage before changing it." Margin="0,4,0,18" Foreground="#5A6472"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Padding="9,6"
                     AutomationProperties.Name="Local drive or folder path"/>
            <Button Grid.Column="1" Content="Analyze" Command="{Binding AnalyzeCommand}" Margin="10,0,0,0" Padding="18,7"/>
            <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0,0,0" Padding="18,7"/>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,18">
            <ProgressBar Height="8" IsIndeterminate="{Binding IsScanning}"/>
            <TextBlock Text="{Binding Status}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <TabControl Grid.Row="3" AutomationProperties.Name="Analysis results">
            <TabItem Header="Summary">
                <StackPanel Margin="18">
                    <TextBlock Text="Analysis summary" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,16,0,0" Text="{Binding Snapshot.TargetPath, StringFormat=Target: {0}, TargetNullValue=No completed scan yet}"/>
                    <TextBlock Margin="0,8,0,0" Text="{Binding Snapshot.LogicalBytes, StringFormat=Measured bytes: {0:N0}}"/>
                    <TextBlock Margin="0,8,0,0" Text="{Binding Snapshot.FileCount, StringFormat=Files: {0:N0}}"/>
                    <TextBlock Margin="0,8,0,0" Text="Cleanup actions are never preselected. Preview and confirmation are required." Foreground="#5A6472"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Categories">
                <DataGrid ItemsSource="{Binding Results.Categories}" AutoGenerateColumns="False" IsReadOnly="True"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Storage categories">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" Width="110"/>
                        <DataGridTextColumn Header="Files" Binding="{Binding FileCount, StringFormat=N0}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Large files">
                <DataGrid ItemsSource="{Binding Results.LargeFiles}" AutoGenerateColumns="False" IsReadOnly="True"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Large files">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" Width="110"/>
                        <DataGridTextColumn Header="Modified" Binding="{Binding LastWriteTimeUtc}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Advanced">
                <StackPanel Margin="18">
                    <CheckBox Content="Show raw diagnostics" IsChecked="{Binding IsAdvancedMode}"/>
                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Results.Warnings}"
                                  Visibility="{Binding ShowAdvancedDiagnostics, Converter={StaticResource BooleanToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,3"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>
            <TabItem Header="Guidance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="Guided recovery" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,12,0,0" Text="Docker &amp; WSL — identify whether data belongs to Docker Desktop or Ubuntu. Images may be rebuilt; volumes may contain databases and are never auto-selected." TextWrapping="Wrap"/>
                        <TextBlock Margin="0,12,0,0" Text="Notion — confirm every page is synchronized, then prefer Notion’s Reset local data control." TextWrapping="Wrap"/>
                        <TextBlock Margin="0,12,0,0" Text="Claude — relocate by copy, verify, retain rollback, and only then create a junction." TextWrapping="Wrap"/>
                        <TextBlock Margin="0,12,0,0" Text="Pagefile — diagnose memory pressure and crash-dump requirements; never delete pagefile.sys manually." TextWrapping="Wrap"/>
                        <TextBlock Margin="0,12,0,0" Text="Hibernation — disabling it is reversible but removes Hibernate and may affect Fast Startup." TextWrapping="Wrap"/>
                        <TextBlock Margin="0,12,0,0" Text="Volume optimization — PathSpace uses Windows Optimize-Volume and lets media type select retrim or defragment behavior." TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

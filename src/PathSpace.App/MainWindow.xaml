<Window x:Class="PathSpace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PathSpace" Height="680" Width="1040" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="PathSpace" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Understand local storage before changing it." Margin="0,4,0,18" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding AvailableDrives}" SelectedItem="{Binding TargetPath}" MinHeight="36" Margin="0,0,8,0"
                      AutomationProperties.Name="Local fixed or removable drive"/>
            <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Padding="9,6"
                     Grid.Column="1" AutomationProperties.Name="Local drive or folder path" AutomationProperties.AutomationId="TargetPath"/>
            <Button Grid.Column="2" Content="Browse…" Click="BrowseButton_Click" Margin="8,0,0,0" Padding="18,7" AutomationProperties.AutomationId="BrowseButton"/>
            <Button Grid.Column="3" Content="Analyze" Command="{Binding AnalyzeCommand}" Margin="8,0,0,0" Padding="18,7" AutomationProperties.AutomationId="AnalyzeButton"/>
            <Button Grid.Column="4" Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0,0,0" Padding="18,7" AutomationProperties.AutomationId="CancelButton"/>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,18">
            <ProgressBar Height="8" IsIndeterminate="{Binding IsScanning}"/>
            <TextBlock Text="{Binding Status}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="StatusText"/>
        </StackPanel>
        <TabControl Grid.Row="3" AutomationProperties.Name="Analysis results">
            <TabItem Header="Summary" AutomationProperties.AutomationId="SummaryTab">
                <StackPanel Margin="18">
                    <TextBlock Text="Analysis summary" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,16,0,0" Text="{Binding Snapshot.TargetPath, StringFormat=Target: {0}, TargetNullValue=No completed scan yet}"/>
                    <TextBlock Margin="0,8,0,0" Text="{Binding Snapshot.LogicalBytes, StringFormat=Measured bytes: {0:N0}}"/>
                    <TextBlock Margin="0,8,0,0" Text="{Binding Snapshot.FileCount, StringFormat=Files: {0:N0}}"/>
                    <TextBlock Margin="0,8,0,0" Text="Cleanup actions are never preselected. Preview and confirmation are required." Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Export JSON…" Click="ExportJsonButton_Click" Padding="14,6" AutomationProperties.AutomationId="ExportJsonButton"/>
                        <Button Content="Export redacted JSON…" Click="ExportRedactedButton_Click" Padding="14,6" Margin="8,0,0,0"/>
                        <Button Content="Export CSV…" Click="ExportCsvButton_Click" Padding="14,6" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Categories" AutomationProperties.AutomationId="CategoriesTab">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" Text="{Binding ResultFilter, UpdateSourceTrigger=PropertyChanged}" Margin="8" Padding="8,5" AutomationProperties.Name="Filter result paths" AutomationProperties.AutomationId="ResultFilter"/>
                    <DataGrid ItemsSource="{Binding FilteredCategories}" AutoGenerateColumns="False" IsReadOnly="True"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Storage categories">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" Width="110"/>
                            <DataGridTextColumn Header="Files" Binding="{Binding FileCount, StringFormat=N0}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Large files">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" Text="{Binding ResultFilter, UpdateSourceTrigger=PropertyChanged}" Margin="8" Padding="8,5" AutomationProperties.Name="Filter large-file paths"/>
                    <DataGrid ItemsSource="{Binding FilteredLargeFiles}" AutoGenerateColumns="False" IsReadOnly="True"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Large files">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" Width="110"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding LastWriteTimeUtc}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Recommendations" AutomationProperties.AutomationId="RecommendationsTab">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ListBox ItemsSource="{Binding Recommendations}" SelectedItem="{Binding SelectedRecommendation}" AutomationProperties.AutomationId="RecommendationList"
                             AutomationProperties.Name="Storage recovery recommendations" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding EstimatedMaxBytes, StringFormat=Measured upper bound: {0:N0} bytes}" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding Risk, StringFormat=Risk: {0}}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Reversibility, StringFormat=Recovery: {0}}"/>
                                        <TextBlock Text="{Binding RequiresElevation, StringFormat=Administrator required: {0}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Action preview and confirmation" FontWeight="SemiBold"/>
                            <Button Content="Preview selected action" Command="{Binding PreviewActionCommand}" HorizontalAlignment="Left" Padding="14,6" Margin="0,8,0,0" AutomationProperties.AutomationId="PreviewActionButton"/>
                            <TextBlock Text="{Binding CurrentPreview.Title, StringFormat=Preview: {0}}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding CurrentPreview.EstimatedBytes, StringFormat=Measured upper bound: {0:N0} bytes}"/>
                            <ItemsControl ItemsSource="{Binding CurrentPreview.Targets}" Margin="0,5,0,0">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Path}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox Content="_I reviewed these exact targets and explicitly confirm this action" AutomationProperties.AutomationId="ConfirmActionCheckBox"
                                      IsChecked="{Binding HasConfirmedPreview}" Margin="0,8,0,0"/>
                            <Button Content="Execute confirmed preview" Command="{Binding ExecuteActionCommand}" HorizontalAlignment="Left" Padding="14,6" Margin="0,8,0,0" AutomationProperties.AutomationId="ExecuteActionButton"/>
                            <TextBlock Text="{Binding ActionStatus}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ActionStatusText"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Advanced">
                <StackPanel Margin="18">
                    <CheckBox Content="Show raw diagnostics" IsChecked="{Binding IsAdvancedMode}"/>
                    <Button Content="Run protected diagnostics…" Command="{Binding ProtectedDiagnosticsCommand}" HorizontalAlignment="Left" Padding="14,6" Margin="0,10,0,0" AutomationProperties.HelpText="Requests administrator approval for a read-only scan of protected system settings."/>
                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Results.Warnings}"
                                  Visibility="{Binding ShowAdvancedDiagnostics, Converter={StaticResource BooleanToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,3"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Diagnostics}"
                                  Visibility="{Binding ShowAdvancedDiagnostics, Converter={StaticResource BooleanToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,5">
                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Available, StringFormat=Available: {0}}"/>
                                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding Data}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,3,0,0" MaxHeight="120" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>
            <TabItem Header="Guidance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="Guided recovery" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,12,0,0" Text="Docker &amp; WSL — identify whether data belongs to Docker Desktop or Ubuntu. Images may be rebuilt; volumes may contain databases and are never auto-selected." TextWrapping="Wrap"/>
                        <TextBlock Margin="0,12,0,0" Text="Notion — confirm every page is synchronized on another device or notion.so. Close Notion, then use its Reset &amp; erase all local data control; PathSpace never deletes unknown Notion partitions." TextWrapping="Wrap"/>
                        <TextBlock Margin="0,12,0,0" Text="Claude — close Claude, copy the runtime to an NTFS destination, preserve ACLs, compare file counts and bytes, retain a .c-backup, create a junction, then launch and test Claude before removing the rollback copy." TextWrapping="Wrap"/>
                        <TextBlock Margin="0,12,0,0" Text="Pagefile — diagnose memory pressure and crash-dump requirements; never delete pagefile.sys manually." TextWrapping="Wrap"/>
                        <TextBlock Margin="0,12,0,0" Text="Hibernation — disabling it is reversible but removes Hibernate and may affect Fast Startup." TextWrapping="Wrap"/>
                        <TextBlock Margin="0,12,0,0" Text="Volume optimization — PathSpace uses Windows Optimize-Volume and lets media type select retrim or defragment behavior." TextWrapping="Wrap"/>
                        <TextBlock Margin="0,16,0,4" Text="Validated read-only commands" FontWeight="SemiBold"/>
                        <TextBox Text="wsl --list --verbose" IsReadOnly="True"/>
                        <TextBox Text="wsl -d Ubuntu -- docker system df -v" IsReadOnly="True" Margin="0,5,0,0"/>
                        <TextBox Text="docker system df -v" IsReadOnly="True" Margin="0,5,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
